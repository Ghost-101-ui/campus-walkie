# Cloudflare Worker WebSocket Signaling Relay URL (wss:// scheme)
VITE_RELAY_URL=wss://campus-walkie-relay.workers.dev

# Optional TURN server settings (if connecting behind strict enterprise symmetric NATs)
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USER=username
# VITE_TURN_PASS=password

# Base URL override (defaults to relative ./)
# VITE_BASE=./
